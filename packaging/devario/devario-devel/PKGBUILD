  'gawk'
  'gcc'
  'gettext'
  'grep'
  'groff'
  'gzip'
  'libtool'
  'm4'
  'make'
  'patch'
  'pkgconf'
  'sed'
  'sudo'
  'texinfo'
  'which'
  # Native --isolated builds use systemd-nspawn and unshare.
  'systemd'
  'util-linux'
)

# This subset does not provide base-devel or devtools. The --chroot path uses
# mkarchroot/makechrootpkg from devtools; use Shelly's --isolated path on Devario.
package() {
